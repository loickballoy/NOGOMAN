{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": { "^.+\\.ts$": "ts-jest" },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/env.ts"],
  "globalSetup": "<rootDir>/global-setup.ts",
  "testSequencer": "<rootDir>/sequencer.js",
  "testTimeout": 60000
}
