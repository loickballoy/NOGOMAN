// Nogoman data model.
// Money is stored as integer XOF (FCFA has no minor unit).

generator client {
  provider      = "prisma-client-js"
  // "native" for development machines, the Debian/OpenSSL 3 target for the Docker image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  WORKER
  FARMER
  ADMIN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum MobileMoneyOperator {
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  WAVE
}

enum JobCategory {
  HARVEST
  PLANTING
  WEEDING
  CLEARING
  TREATMENT
  TRANSPORT
  OTHER
}

enum PayMode {
  DAILY
  TASK
}

enum JobStatus {
  OPEN
  FILLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  HIRED
  REJECTED
  WITHDRAWN
}

enum EngagementStatus {
  AWAITING_FUNDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WorkUnitStatus {
  PENDING
  RELEASED
  DISPUTED
  MISSED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PayoutStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum LedgerAccountType {
  PROVIDER_CLEARING
  ESCROW
  USER_PAYABLE
  PLATFORM_REVENUE
}

enum MessageKind {
  TEXT
  VOICE
}

enum JournalKind {
  FUNDING
  RELEASE
  REFUND
  PAYOUT
  PAYOUT_REVERSAL
}

model User {
  id             String               @id @default(cuid())
  phone          String               @unique // E.164, never exposed to other users
  name           String?
  role           Role?
  bio            String?
  locality       String?
  lat            Float?
  lng            Float?
  kycLevel       Int                  @default(0) // 0 phone, 1 ID + selfie, 2 business
  kycStatus      KycStatus            @default(NOT_STARTED)
  payoutOperator MobileMoneyOperator?
  payoutPhone    String?
  ratingSum      Int                  @default(0)
  ratingCount    Int                  @default(0)
  disabledAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  sessions         Session[]
  jobs             Job[]
  applications     Application[]
  engagements      Engagement[]
  payments         Payment[]
  payouts          Payout[]
  reviewsWritten   Review[]        @relation("ReviewAuthor")
  reviewsReceived  Review[]        @relation("ReviewSubject")
  ledgerAccounts   LedgerAccount[]
  messages         Message[]
  /// Times this user tried to share a phone number, email or link in chat.
  contactFlagCount Int             @default(0)
}

model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  refreshHash String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Job {
  id               String      @id @default(cuid())
  farmerId         String
  title            String
  description      String      @default("")
  category         JobCategory
  crop             String?
  payMode          PayMode
  rateXof          Int // per day (DAILY) or per worker for the whole task (TASK)
  workersNeeded    Int
  durationDays     Int // number of paid days (DAILY) or estimated length (TASK)
  startDate        DateTime    @db.Date
  locality         String // short place name shown to everyone ("Étampes", "Daloa")
  address          String? // full geocoded address, shown only to the farmer and hired workers
  locationVerified Boolean     @default(false) // the server matched lat/lng to a real place
  lat              Float
  lng              Float
  status           JobStatus   @default(OPEN)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  farmer         User            @relation(fields: [farmerId], references: [id])
  applications   Application[]
  engagements    Engagement[]
  payments       Payment[]
  ledgerAccounts LedgerAccount[]

  @@index([status, lat, lng])
  @@index([farmerId])
}

model Application {
  id        String            @id @default(cuid())
  jobId     String
  workerId  String
  status    ApplicationStatus @default(PENDING)
  message   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  job          Job           @relation(fields: [jobId], references: [id])
  worker       User          @relation(fields: [workerId], references: [id])
  engagement   Engagement?
  conversation Conversation?

  @@unique([jobId, workerId])
}

model Engagement {
  id            String           @id @default(cuid())
  jobId         String
  workerId      String
  applicationId String           @unique
  status        EngagementStatus @default(AWAITING_FUNDING)
  payMode       PayMode
  rateXof       Int
  unitCount     Int
  paymentId     String?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  job         Job         @relation(fields: [jobId], references: [id])
  worker      User        @relation(fields: [workerId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])
  payment     Payment?    @relation(fields: [paymentId], references: [id])
  workUnits   WorkUnit[]
  reviews     Review[]

  @@unique([jobId, workerId])
}

// One payable unit of work: a day (DAILY) or the whole task (TASK).
model WorkUnit {
  id            String         @id @default(cuid())
  engagementId  String
  index         Int
  workDate      DateTime       @db.Date
  grossXof      Int // what the farmer agreed to pay for this unit
  farmerFeeXof  Int
  workerFeeXof  Int
  status        WorkUnitStatus @default(PENDING)
  checkInAt     DateTime?
  checkInLat    Float?
  checkInLng    Float?
  completedAt   DateTime? // TASK: worker marked the task as done
  confirmedAt   DateTime?
  autoReleaseAt DateTime?
  releasedAt    DateTime?
  disputeReason String?
  disputedById  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  engagement Engagement @relation(fields: [engagementId], references: [id])

  @@unique([engagementId, index])
  @@index([status, autoReleaseAt])
}

model Payment {
  id            String               @id @default(cuid())
  payerId       String
  jobId         String
  provider      String
  providerRef   String?              @unique
  operator      MobileMoneyOperator?
  phone         String?
  amountXof     Int
  feeXof        Int
  status        PaymentStatus        @default(PENDING)
  checkoutUrl   String?
  failureReason String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  payer       User         @relation(fields: [payerId], references: [id])
  job         Job          @relation(fields: [jobId], references: [id])
  engagements Engagement[]
}

model Payout {
  id            String              @id @default(cuid())
  userId        String
  provider      String
  providerRef   String?             @unique
  operator      MobileMoneyOperator
  phone         String
  amountXof     Int
  status        PayoutStatus        @default(PENDING)
  failureReason String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model LedgerAccount {
  id        String            @id @default(cuid())
  code      String            @unique // e.g. escrow:job:<id>, payable:user:<id>
  type      LedgerAccountType
  userId    String?
  jobId     String?
  createdAt DateTime          @default(now())

  user     User?     @relation(fields: [userId], references: [id])
  job      Job?      @relation(fields: [jobId], references: [id])
  postings Posting[]
}

// Double-entry journal. Postings of an entry always sum to zero:
// positive = credit (held for / owed to the account), negative = debit.
model JournalEntry {
  id             String      @id @default(cuid())
  kind           JournalKind
  idempotencyKey String      @unique
  memo           String?
  createdAt      DateTime    @default(now())

  postings Posting[]
}

model Posting {
  id        String @id @default(cuid())
  entryId   String
  accountId String
  amountXof Int

  entry   JournalEntry  @relation(fields: [entryId], references: [id])
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([entryId])
}

model Review {
  id           String   @id @default(cuid())
  engagementId String
  authorId     String
  subjectId    String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  engagement Engagement @relation(fields: [engagementId], references: [id])
  author     User       @relation("ReviewAuthor", fields: [authorId], references: [id])
  subject    User       @relation("ReviewSubject", fields: [subjectId], references: [id])

  @@unique([engagementId, authorId])
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  payload   Json
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

/// One thread per application: the worker and the farmer can talk from the moment
/// the worker applies. Phone numbers are masked; voice notes are kept on the server.
model Conversation {
  id            String    @id @default(cuid())
  applicationId String    @unique
  jobId         String
  farmerId      String
  workerId      String
  lastMessageAt DateTime?
  farmerReadAt  DateTime?
  workerReadAt  DateTime?
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id])
  messages    Message[]

  @@index([farmerId, lastMessageAt])
  @@index([workerId, lastMessageAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  kind           MessageKind
  text           String? // already masked
  audioPath      String? // file name under UPLOAD_DIR
  audioMs        Int?
  flags          String[] // what the contact filter removed: PHONE, EMAIL, LINK, APP
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}
