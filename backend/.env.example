# Run ./scripts/init-env.sh to create .env with generated secrets, then fill in the rest.
# To generate a secret by hand: openssl rand -hex 32 (hex only: the DB password goes into a URL)

# --- Docker Compose ---
POSTGRES_PASSWORD=change-me
# 127.0.0.1 = host only. Set to the host's Tailscale IP to reach the API from your tailnet.
API_BIND=127.0.0.1
# From Cloudflare Zero Trust > Networks > Tunnels (public hostname -> http://api:3000)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Local development without Docker (Compose sets this itself) ---
# DATABASE_URL=postgresql://nogoman@127.0.0.1:5433/nogoman

# --- App ---
NODE_ENV=production
JWT_SECRET=
OTP_SECRET=
# Comma-separated origins allowed to call the API from a browser (the website)
CORS_ORIGINS=https://nogoman.ci
ENABLE_DOCS=false
# Phones that become admins on first login (E.164)
ADMIN_PHONES=

# NODE_ENV=production refuses SMS_PROVIDER=console. For a private test deployment before you
# have an SMS account, use NODE_ENV=staging and SMS_PROVIDER=console: login codes
# then appear in `docker compose logs api`.
# SMS: "orange" (recommended for Côte d'Ivoire), "africastalking", or "console" (logs only).
SMS_PROVIDER=orange
# Orange Developer > My apps > your app with the "SMS Côte d'Ivoire" API: client ID and secret.
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Country sender number. Leave as is unless Orange gives you another one.
ORANGE_SENDER_ADDRESS=tel:+2250000
# Shows "Nogoman" instead of a number. Only once Orange has approved the sender name.
ORANGE_SENDER_NAME=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false
# Anti-abuse: login codes per number per day, and for everyone per day (beyond that logins pause,
# so bots can't burn the SMS budget). Per-IP per minute limits for code requests and checks.
OTP_MAX_PER_DAY=10
SMS_DAILY_LIMIT=1000
OTP_REQUESTS_PER_IP_MINUTE=5
OTP_VERIFY_PER_IP_MINUTE=10

# Admin routes (disputes, ID status, payouts) only answer over Tailscale/LAN, never through
# Cloudflare. Only set to true if you have no other way in, and protect /admin with Cloudflare Access.
ADMIN_OVER_INTERNET=false

# Payments: only the mock provider exists until the aggregator is integrated.
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=

# Commission in basis points (100 = 1 %): 5 % added to what the farmer pays, 3 % taken from what
# the worker receives (a 4 000 FCFA day costs 4 200 and pays 3 880). Rates are frozen on each
# payment at funding: changing them never affects a mission already paid for.
FARMER_FEE_BPS=500
WORKER_FEE_BPS=300
# Lowest rate a job may offer, in FCFA: per day (DAILY) or per worker for the task (TASK)
MIN_DAILY_RATE_XOF=2000
# Unconfirmed days are paid automatically at this hour (UTC = Abidjan time) the next morning
AUTO_RELEASE_HOUR_UTC=9
# A task marked done by the worker is paid after this many hours without objection
TASK_AUTO_RELEASE_HOURS=48
CHECKIN_RADIUS_KM=2
# Balances below this amount wait for the next daily pass (fewer transfer fees)
MIN_PAYOUT_XOF=2000
# Hour (0-23, UTC = Abidjan time) of the daily payout pass: one transfer per user and per day
PAYOUT_HOUR_UTC=18
# Payouts wait this long after someone changes their payout number (an SMS warns them)
PAYOUT_HOLD_HOURS=48
# Turn on once ID verification (Smile ID) is integrated
REQUIRE_KYC_TO_TRANSACT=false

# Geocoding: names farm positions and checks addresses (OpenStreetMap Nominatim, free, no key).
# "none" disables it; job locations are then marked unverified.
GEOCODER=nominatim
# Your email: Nominatim's usage policy asks for a way to contact you.
GEOCODER_CONTACT=
# Limit address search to these countries (ISO codes, comma-separated). Empty = worldwide.
GEOCODE_COUNTRIES=
# NOMINATIM_URL=https://nominatim.openstreetmap.org
